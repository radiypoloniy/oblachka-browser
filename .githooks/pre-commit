#!/bin/sh
# Сторож перед коммитом: гоняет то, что относится к изменённым файлам.
#
# Зачем. Все правила проекта до сих пор жили в CLAUDE.md, то есть на уровне текста, и держались
# на памяти человека: «после изменений собери, проверь типы обоих таргетов и прогони npm test».
# Правило, которое надо помнить, рано или поздно не выполняется — а `npm test` занимает шесть
# секунд, то есть повода его пропускать нет вообще. Здесь оно перестаёт быть просьбой.
#
# ⚠️ Проверяется РАБОЧЕЕ ДЕРЕВО, а не проиндексированный снимок. Частичный коммит (`git add -p`)
# хук пропустит по состоянию файлов на диске, а не по тому, что реально уйдёт в коммит. Честный
# способ — прятать неиндексированное через stash, но stash посреди коммита сам по себе рискует
# незакоммиченной работой, а это дороже пойманной ошибки. Помни об ограничении, не чини stash-ем.
#
# Пропустить осознанно: git commit --no-verify
#
# Ставится сам при npm install (scripts/install-hooks.mjs выставляет core.hooksPath).

set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# Документация и картинки проверок не требуют: коммит правки в README не должен стоить двадцати
# секунд, иначе хук начнут обходить по привычке — и он перестанет ловить настоящие правки.
code=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|mjs|js|css|json)$' || true)
[ -z "$code" ] && exit 0

echo ""
echo "── pre-commit ────────────────────────────────────────────"

# Проверки статики читают и src/, и electron/, а contract-check — обе стороны IPC. Поэтому
# гоняем их на любую правку кода, а не только на правку shared/.
echo "  проверки (npm test)…"
npm test --silent >/dev/null 2>&1 || {
  echo "  ✗ проверки не прошли — подробности: npm test"
  exit 1
}

# Типы — только у затронутого таргета: renderer проверяется десять секунд, main пять, и платить
# за оба ради правки одной кнопки незачем. shared/ тянет за собой оба — его читают обе стороны.
need_renderer=$(printf '%s\n' "$code" | grep -E '^(src|shared)/' || true)
need_main=$(printf '%s\n' "$code" | grep -E '^(electron|shared)/' || true)

if [ -n "$need_renderer" ]; then
  echo "  типы renderer…"
  npx tsc -p tsconfig.json --noEmit || {
    echo "  ✗ типы renderer не сходятся"
    exit 1
  }
fi

if [ -n "$need_main" ]; then
  # ⚠️ Этот вызов ЭМИТИТ в dist-electron (--noEmit тут нельзя: tsconfig main-процесса собирает
  # реальную сборку). Каталог в .gitignore, в коммит не попадёт.
  echo "  типы main…"
  npx tsc -p electron/tsconfig.json || {
    echo "  ✗ типы main не сходятся"
    exit 1
  }
fi

echo "  всё чисто"
echo ""
