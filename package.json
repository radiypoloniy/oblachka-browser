{
  "name": "oblako-browser",
  "version": "0.1.0",
  "description": "Oblako — приватный AI-браузер. Прототип ядра (Этап 1).",
  "main": "dist-electron/electron/main.js",
  "author": "Oblako",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json && wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build:vite": "vite build",
    "build": "npm run build:vite && npm run build:electron",
    "start": "cross-env NODE_ENV=production electron .",
    "download-filters": "node scripts/download-filters.mjs",
    "download-model": "node scripts/download-model.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo [postinstall] better-sqlite3 rebuild skipped — history unavailable without C++ tools"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@ghostery/adblocker-electron": "^2.18.0",
    "@huggingface/transformers": "^3.8.1",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "franc-min": "^6.2.0",
    "lucide-react": "0.383.0",
    "node-llama-cpp": "^3.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "40.10.4",
    "playwright-core": "^1.61.0",
    "typescript": "5.4.5",
    "vite": "5.3.1",
    "wait-on": "7.2.0"
  }
}
